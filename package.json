{
  "name": "opencode-agent",
  "version": "0.1.0",
  "description": "Use OpenCode sessions as persistent CLI-controlled subagents.",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "files": [
    "src",
    "!src/*.test.ts",
    "README.md"
  ],
  "bin": {
    "opencode-agent": "./src/index.ts"
  },
  "scripts": {
    "start": "bun ./src/index.ts",
    "test": "bun test",
    "test:all": "bun run typecheck && bun test && bun run test:terminal",
    "test:live": "bun ./scripts/live-terminal-smoke.ts",
    "test:terminal": "bun ./scripts/terminal-suite.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^6.0.0"
  }
}
